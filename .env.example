# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key: server-side only, never in the browser or in git
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Anthropic API key used to score job fit
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# Gmail account that sends the daily digest
GMAIL_USER=you@gmail.com
# Gmail app password (Google Account > Security > App passwords; needs 2-step verification)
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# Digest recipient (defaults to GMAIL_USER)
DIGEST_TO=you@gmail.com
# Profile text for scoring; locally the script reads perfil/resumo-cv.md when this is empty
CANDIDATE_PROFILE=
