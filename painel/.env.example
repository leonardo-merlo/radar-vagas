# Supabase project URL (same project as the radar)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase anon (public) key; data access is limited by RLS to emails in dashboard_users
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public URL of the deployed dashboard, used in the login link when the Origin header is missing
NEXT_PUBLIC_SITE_URL=http://localhost:3000
