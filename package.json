{
  "name": "radar-vagas",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx src/run.ts --dry-run",
    "build": "tsc",
    "lint": "tsc",
    "test": "vitest run",
    "radar": "tsx src/run.ts",
    "fila": "tsx src/cli/queue.ts",
    "marca": "tsx src/cli/mark.ts",
    "contatos": "tsx src/cli/contacts.ts",
    "painel": "npm --prefix painel run dev",
    "agendar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agendar.ps1"
  },
  "description": "Daily job radar that runs on your own machine: collects remote dev jobs from public boards, scores fit with Claude Code and shows them in a local dashboard.",
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
